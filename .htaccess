DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>
Options -Indexes
<FilesMatch "^(config|course|studio|ai|survey|portal|attendance|roster|roster-seed)\.php$|\.(zip|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>


